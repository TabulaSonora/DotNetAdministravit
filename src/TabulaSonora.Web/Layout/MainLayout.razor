@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject SynthSession Session
@inject PlaybackPump Pump

@*
    Everything both pages share: the identity of the page, the nav between them, and the ROM gate.

    The gate lives here rather than on each page for two reasons. It is the same gate -- neither page
    can do anything without a DLL -- and putting it in the layout means the stored-DLL load in
    RomLoader.OnInitializedAsync runs once for the session instead of once per navigation.
*@

@*
    Above the header rather than inside it, and that is not a layout preference: a sticky element is
    confined to its containing block, so a nav inside <header> would unstick and scroll away the
    moment the title block left the screen.

    NavLink sets aria-current on the match, which is what app.css styles, so there is no active-page
    state to keep anywhere. Match.All on the player, or every URL would light it up.
*@
<nav class="nav">
    <NavLink href="" Match="NavLinkMatch.All">Player</NavLink>
    <NavLink href="live">Live</NavLink>
</nav>

<header>
    <div class="page-head">
        <div>
            <span class="sec-label">Sound Canvas VA</span>
            <h1>Tabula Sonora</h1>
        </div>
        <LSThemeToggle />
    </div>

    <p class="lede">
        A managed reimplementation of the Roland Sound Canvas VA synth voice, running entirely in this
        tab. Your <code>SCCore.dll</code> is read here, cached here, and never leaves the machine.
    </p>
</header>

@* The gate is here; what it gates is each page's own business. The layout must not hide the body on
   it, or a mistyped URL would answer with an empty page instead of saying there is no such page. *@
<main>
    <RomLoader />
    @Body
</main>

<footer>
    <p>
        32 kHz internally, as the hardware is. Effects run from coefficients harvested out of the real
        engine, which a browser cannot do for itself &mdash; they are one of the two pieces of Roland-derived
        data this page carries, and everything else comes from the DLL you supplied.
    </p>
    <p class="colophon">
        @* The notice sits beside the licence deliberately: the BSD grant covers this repository's own
           contents and cannot cover Roland's, and saying only "BSD 3-Clause" would imply otherwise. *@
        <a href="https://github.com/TabulaSonora/DotNetAdministravit" target="_blank" rel="noopener">Source on GitHub</a>
        &middot;
        <a href="https://github.com/TabulaSonora/DotNetAdministravit/blob/main/LICENSE" target="_blank" rel="noopener">BSD 3-Clause</a>
        &middot;
        <a href="https://github.com/TabulaSonora/DotNetAdministravit/blob/main/NOTICE.md" target="_blank" rel="noopener">Third-party rights</a>

        @* Which build this is. The site is published by hand from a working tree, so without this
           there is no way to tell from the page whether what is live is what was last pushed. *@
        @if (BuildInfo.Commit != "unknown")
        {
            <text>&middot;</text>
            <a class="technical" target="_blank" rel="noopener"
               href="@($"https://github.com/TabulaSonora/DotNetAdministravit/commit/{BuildInfo.Commit}")">
                @BuildInfo.Commit[..8]
            </a>

            @* Built from a tree with tracked changes in it, so the hash above does not describe it. *@
            @if (BuildInfo.Dirty)
            {
                <span class="tag tag-warn">modified</span>
            }
        }
    </p>
</footer>

@code {
    // Loading a song enables the export; loading a ROM brings up everything below the loader. Blazor
    // re-renders only the component that handled the event, so the layout redraws from the session
    // instead, which cascades to every panel on whichever page is showing.
    protected override void OnInitialized() => Session.Changed += Redraw;

    private void Redraw() => InvokeAsync(StateHasChanged);

    // The layout, not a page. A page is disposed on every navigation, so tearing the engine down here
    // would have meant the first click of the nav silencing the instrument.
    public ValueTask DisposeAsync()
    {
        Session.Changed -= Redraw;
        Pump.Dispose();
        Session.Dispose();
        return ValueTask.CompletedTask;
    }
}
