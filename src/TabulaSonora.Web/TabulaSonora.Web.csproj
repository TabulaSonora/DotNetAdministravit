<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <RootNamespace>TabulaSonora.Web</RootNamespace>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!--
      Nothing here is localised and no user-facing number is formatted through a culture, so the ICU
      data is dead weight in a download that already asks the user for a 27 MB DLL.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The DSP is scalar float in long loops, which is what AOT is for: interpreted, the block loop
      runs at a small multiple of realtime and playback has no headroom left over for the UI. AOT
      needs 'dotnet workload install wasm-tools'; without it the app still builds and runs, only
      slower, so this is conditioned on Release rather than made a hard requirement of the clone.
    -->
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <WasmEnableSIMD>true</WasmEnableSIMD>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The library only. Never TabulaSonora.Player: its audio host is a native PortAudio binding and
      cannot load in WebAssembly. Output here goes through an AudioWorklet instead.
    -->
    <ProjectReference Include="..\TabulaSonora\TabulaSonora.csproj" />
  </ItemGroup>

  <!--
    Stamp the build with the commit it came from, so the deployed page can say which one it is. The
    site is published by hand from a working tree; without this, "is what is live the thing I just
    pushed" is unanswerable from the page itself.

    Generated as a source file with static fields rather than as assembly attributes read back by
    reflection. Attributes would work, but this build trims and AOT-compiles, and a field initialised
    from a literal cannot be trimmed away or fail to resolve at runtime.

    static readonly and not const, which matters: a const bool folds at the call site, so the branch
    that reports a modified tree becomes provably unreachable in any build made from a clean one, and
    this project turns that warning into an error.

    Every git call tolerates failure. A clone without git, or a source archive with no history at
    all, still has to build; it just reports an unknown commit.
  -->
  <Target Name="EmbedBuildInfo" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse --short=12 HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low"
          ContinueOnError="true" IgnoreExitCode="true" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExit" />
    </Exec>

    <!-- Tracked changes only: an untracked scratch file is not a different build of the engine. -->
    <Exec Command="git status --porcelain --untracked-files=no" ConsoleToMSBuild="true"
          StandardOutputImportance="low" ContinueOnError="true" IgnoreExitCode="true"
          WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitStatus" />
    </Exec>

    <PropertyGroup>
      <_BuildCommit Condition="'$(_GitExit)' == '0' and '$(_GitCommit)' != ''">$(_GitCommit.Trim())</_BuildCommit>
      <_BuildCommit Condition="'$(_BuildCommit)' == ''">unknown</_BuildCommit>
      <_BuildDirty Condition="'$(_GitStatus)' != ''">true</_BuildDirty>
      <_BuildDirty Condition="'$(_BuildDirty)' == ''">false</_BuildDirty>
      <_BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</_BuildInfoFile>
    </PropertyGroup>

    <ItemGroup>
      <_BuildInfoLines Include="// Generated by the EmbedBuildInfo target. Do not edit." />
      <_BuildInfoLines Include="namespace TabulaSonora.Web%3B" />
      <_BuildInfoLines Include="internal static class BuildInfo" />
      <_BuildInfoLines Include="{" />
      <_BuildInfoLines Include="    public static readonly string Commit = &quot;$(_BuildCommit)&quot;%3B" />
      <_BuildInfoLines Include="    public static readonly bool Dirty = $(_BuildDirty)%3B" />
      <_BuildInfoLines Include="}" />
    </ItemGroup>

    <!--
      WriteOnlyWhenDifferent so the file changes only when the commit or the dirty flag does, which
      is what keeps this from recompiling the project on every build. A build timestamp was the
      obvious thing to put here and is exactly what would have broken that.
    -->
    <WriteLinesToFile File="$(_BuildInfoFile)" Lines="@(_BuildInfoLines)" Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <ItemGroup>
      <Compile Include="$(_BuildInfoFile)" />
      <FileWrites Include="$(_BuildInfoFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!--
      A browser cannot harvest these coefficients for itself: the engine computes them at start-up and
      only a Windows x64 host can run it. This is one of the two pieces of Roland-derived data the repository
      carries, and shipping it is what gives the browser build its effects. See NOTICE.md.

      Embedded in THIS assembly rather than the library's. The library deliberately does not compile
      them in, so that a host embedding TabulaSonora.dll does not acquire Roland's data by accident,
      and embedding rather than copying to wwwroot keeps one copy of the file in the tree.
    -->
    <EmbeddedResource Include="..\TabulaSonora\Effects\presets.json"
                      LogicalName="TabulaSonora.Web.presets.json" />
  </ItemGroup>

</Project>
