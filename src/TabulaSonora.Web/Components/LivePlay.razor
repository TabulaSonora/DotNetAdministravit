@implements IDisposable
@inject SynthSession Session
@inject MidiInput Midi
@inject PlaybackPump Pump

@*
    The keyboard and what plays into it. Which sound it plays is the instrument picker's business, and
    the channel chosen here is what that picker sends its program changes to.

    Live playing needs the pump running even with no song loaded: with no sequence to drive, the
    session renders straight from the generator, which is what these notes sound into.
*@

<section class="panel enter-rise">
    <h2>Play it</h2>

    <div class="row">
        @if (!Midi.IsSupported)
        {
            <span class="tag tag-warn">This browser has no Web MIDI. The on-screen keyboard still works.</span>
        }
        else if (!Midi.IsOpen)
        {
            <button class="btn btn-secondary" @onclick="ConnectAsync">Connect MIDI input</button>
        }
        else
        {
            <label>
                Input
                <select @onchange="ListenAsync">
                    <option value="">— none —</option>
                    @foreach (var device in Midi.Devices)
                    {
                        <option value="@device.Id" selected="@device.Connected">@device.Name</option>
                    }
                </select>
            </label>
            <span class="tag tag-muted">@Midi.Devices.Count device(s)</span>
        }

        @* This page's one primary action, and only while it is worth pressing: nothing is audible
           until a context exists, and a browser will only start one inside a gesture. Once the device
           is running it has nothing left to do and steps back to secondary. *@
        <button class="btn @(Armed ? "btn-secondary" : "btn-primary")" @onclick="ArmAsync" disabled="@Armed">
            Start audio
        </button>

        @if (Pump.Mode == PlaybackMode.Song && Pump.State == TransportState.Playing)
        {
            <span class="note">
                Playing a song, so keys come through the song's own buffer and arrive late. Pause it,
                or press Start audio, to play at low latency.
            </span>
        }
    </div>

    <div class="row">
        <label>
            Channel
            <select value="@Channel" @onchange="ChannelPicked">
                @for (var c = 0; c < ChannelMask.ChannelCount; c++)
                {
                    var index = c;
                    <option value="@index">@(index + 1)@(index == SynthSession.DrumChannel ? " (drums)" : "")</option>
                }
            </select>
        </label>

        <label>
            Velocity
            <input type="range" min="1" max="127" value="@Velocity" @oninput="VelocityMoved" />
            <span class="technical">@Velocity</span>
        </label>

        <span class="note">@Sounding</span>
    </div>

    <Keyboard Velocity="Velocity" NoteOn="NoteOn" NoteOff="NoteOff" />
</section>

@code {
    /// <summary>The channel the keyboard plays on.</summary>
    [Parameter]
    public int Channel { get; set; }

    /// <summary>Raised when the channel is changed here.</summary>
    [Parameter]
    public EventCallback<int> ChannelChanged { get; set; }

    /// <summary>The velocity every key sends.</summary>
    [Parameter]
    public int Velocity { get; set; } = 100;

    /// <summary>Raised when the velocity is changed here.</summary>
    [Parameter]
    public EventCallback<int> VelocityChanged { get; set; }

    private bool Armed => Pump.State == TransportState.Playing;

    // What the chosen channel is currently set to sound, named the way the picker names it. The drum
    // part is not a program in the melodic sense at all, so it says so rather than showing an
    // instrument name that would be a plain lie about what a key will do.
    private string Sounding
    {
        get
        {
            if (Session.Parts is not { } parts || Session.Directory is not { } directory)
            {
                return string.Empty;
            }

            var part = parts[Channel];
            if (Channel == SynthSession.DrumChannel)
            {
                return $"Drum part — program {part.Program + 1} selects the kit.";
            }

            var tone = directory.ProgramToTone(part.Program, Session.Map, part.Bank);
            var name = tone >= 0 && directory.GetTone(tone) is { IsDefined: true } record
                ? record.Name.Trim()
                : "nothing";

            return $"Bank {part.Bank}, program {part.Program + 1} — {name}.";
        }
    }

    protected override void OnInitialized()
    {
        Midi.Changed += Redraw;

        // A program change from the picker, from hardware or from a song changes what this panel says
        // is sounding, and none of those are events this component handled.
        Session.Changed += Redraw;
        Pump.Tick += Redraw;
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    private async Task ConnectAsync()
    {
        await Midi.OpenAsync();
        StateHasChanged();
    }

    private async Task ListenAsync(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        await Midi.ListenAsync(string.IsNullOrEmpty(id) ? null : id);
        await ArmAsync();
    }

    private Task ArmAsync() => Pump.ArmForKeysAsync();

    private Task ChannelPicked(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var channel)
            ? ChannelChanged.InvokeAsync(channel)
            : Task.CompletedTask;

    private Task VelocityMoved(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var velocity)
            ? VelocityChanged.InvokeAsync(velocity)
            : Task.CompletedTask;

    private async Task NoteOn(int note)
    {
        await ArmAsync();
        Session.SendChannel(0x90 | Channel, note, Velocity);
    }

    private void NoteOff(int note) => Session.SendChannel(0x80 | Channel, note, 0);

    public void Dispose()
    {
        Midi.Changed -= Redraw;
        Session.Changed -= Redraw;
        Pump.Tick -= Redraw;
    }
}
