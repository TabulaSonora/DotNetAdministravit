@implements IDisposable
@inject SynthSession Session
@inject PlaybackPump Pump

<section class="panel enter-rise">
    <h2>Song</h2>

    <div class="row">
        <InputFile OnChange="LoadAsync" accept=".mid,.midi" />
        @if (Session.Song is { } loaded)
        {
            <span class="technical">@loaded.Name &mdash; @Format(loaded.Duration)</span>
        }
    </div>

    @if (Session.Song is not null)
    {
        @* Play is the page's single primary action once a ROM is loaded, so it is the only orange
           button on screen; everything else here, and Render to WAV below, stays secondary. *@
        <div class="row transport">
            <button class="btn btn-primary" @onclick="PlayAsync" disabled="@(Pump.State == TransportState.Playing && Pump.Mode == PlaybackMode.Song)">Play</button>
            <button class="btn btn-secondary" @onclick="PauseAsync" disabled="@(Pump.State != TransportState.Playing)">Pause</button>
            <button class="btn btn-ghost" @onclick="() => SeekAsync(0)">Rewind</button>
            <button class="btn btn-ghost" @onclick="() => NudgeAsync(-10)">&minus;10s</button>
            <button class="btn btn-ghost" @onclick="() => NudgeAsync(10)">+10s</button>
        </div>

        <input type="range" class="scrub"
               min="0" max="@Session.Song.LengthSamples" step="320"
               value="@Pump.AudiblePosition"
               @onchange="ScrubAsync" />

        @* Status rather than prose, so these take the pill register. It also keeps a warning from
           reading as something to press: --warning is the brand orange, and as a filled chip it
           cannot be mistaken for the primary button. *@
        @* The device's own readouts moved to the Audio panel, which is on both pages and sits beside
           the control that changes them. What is left here is what belongs to the song. *@
        <div class="row readouts">
            <span class="technical clock">@Format(Elapsed) / @Format(Session.Song.Duration)</span>
            <span class="tag tag-muted">@Session.ActiveVoices of 64 voices</span>
            <span class="tag tag-muted">@Session.NoteCount notes</span>
        </div>
    }

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
</section>

@code {
    private string? _error;

    private TimeSpan Elapsed =>
        TimeSpan.FromSeconds(Pump.AudiblePosition / (double)ToneGenerator.SampleRate);

    protected override void OnInitialized()
    {
        Pump.Tick += Redraw;
        Session.Changed += Redraw;
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    private async Task LoadAsync(InputFileChangeEventArgs e)
    {
        _error = null;

        try
        {
            // MIDI files are kilobytes, not megabytes: unlike the DLL, this one is small enough that
            // Blazor's own file stream is the simplest thing that works.
            using var buffer = new MemoryStream();
            await using (var stream = e.File.OpenReadStream(maxAllowedSize: 16 * 1024 * 1024))
            {
                await stream.CopyToAsync(buffer);
            }

            await Pump.StopAsync();
            Session.LoadSong(buffer.ToArray(), e.File.Name);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task PlayAsync()
    {
        try
        {
            await Pump.PlaySongAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private Task PauseAsync() => Pump.PauseAsync();

    private Task SeekAsync(long sample) => Pump.SeekAsync(sample);

    private Task NudgeAsync(double seconds) =>
        Pump.SeekAsync(Pump.AudiblePosition + (long)(seconds * ToneGenerator.SampleRate));

    private Task ScrubAsync(ChangeEventArgs e) =>
        long.TryParse(e.Value?.ToString(), out var sample) ? Pump.SeekAsync(sample) : Task.CompletedTask;

    private static string Format(TimeSpan time) => $"{(int)time.TotalMinutes}:{time.Seconds:00}";

    public void Dispose()
    {
        Pump.Tick -= Redraw;
        Session.Changed -= Redraw;
    }
}
