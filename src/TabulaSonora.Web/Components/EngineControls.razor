@inject SynthSession Session

@*
    Changing any of these rebuilds the generator, which is why the note about voices stopping is on
    the panel rather than hidden in a tooltip: a vintage swap mid-song resumes at the same place, but
    whatever was ringing does not survive it.
*@

<section class="panel enter-rise">
    <h2>Engine</h2>

    <div class="row">
        <label>
            Vintage
            @* Enumerated rather than listed, so the four names live in one place and a fifth map
               would appear here by adding it to the enum. *@
            <select value="@((int)Session.Map)" @onchange="MapChanged">
                @foreach (var map in Enum.GetValues<ToneMap>())
                {
                    <option value="@((int)map)">@ToneCatalog.VintageName(map)</option>
                }
            </select>
        </label>

        <span class="note">
            The same program resolves to different tones and pulls samples from different parts of
            the ROM.
        </span>
    </div>

    <div class="row toggles">
        <label>
            <input type="checkbox" checked="@Session.Reverb" @onchange="e => Session.Reverb = Truth(e)" />
            Reverb
        </label>
        <label>
            <input type="checkbox" checked="@Session.Chorus" @onchange="e => Session.Chorus = Truth(e)" />
            Chorus
        </label>
        <label>
            <input type="checkbox" checked="@Session.Delay" @onchange="e => Session.Delay = Truth(e)" />
            Delay
        </label>

        <span class="note">
            On by default, as on the module: a GM reset leaves every part's reverb send at 40, so a
            dry render does not sound like the real thing.
        </span>
    </div>

    <div class="row">
        <button class="btn btn-secondary" @onclick="() => Session.Panic()">Panic</button>
        <span class="note">Silences everything and returns every part to its power-on state.</span>
    </div>

    @* Both secondary: the one orange button on this page belongs to the ROM picker, and to Play
       once there is something to play. *@
    <div class="row">
        <button class="btn btn-secondary" @onclick="RestoreDefaults"
                disabled="@(Session.Settings == EngineSettings.Default)">Restore defaults</button>
        <span class="note">
            The vintage and the three toggles are remembered in this browser. This puts them back to
            SC-8820 with all three running, and forgets them.
        </span>
    </div>
</section>

@code {
    private void MapChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var map))
        {
            Session.Map = (ToneMap)map;
        }
    }

    // Storing the defaults and storing nothing are the same state, so this really does leave the
    // browser as it was before the panel was ever touched; EnginePreferences removes the entry.
    private void RestoreDefaults() => Session.Settings = EngineSettings.Default;

    private static bool Truth(ChangeEventArgs e) => e.Value is bool value && value;
}
