@implements IDisposable
@inject SynthSession Session
@inject ToneCatalog Catalog
@inject PlaybackPump Pump

@*
    Every melodic sound the loaded ROM holds, as three columns that narrow: the vintage, then the
    instrument, then the variants of that instrument the vintage defines.

    Columns rather than a bank rail and a grid of 128, because the grid had the hierarchy upside
    down. A bank is not a place you go to find a sound -- most of its slots are the capital tone
    showing through, so browsing bank 8 means reading 128 entries of which a handful are its own.
    Asking "which banks define a variation of THIS instrument" is the question a player actually has,
    and the answer is usually two or three lines rather than 128.
*@

<section class="panel enter-rise">
    <h2>Instruments</h2>

    @if (Catalog.For(Session.Map) is not { } catalogue)
    {
        <p class="note">No ROM loaded.</p>
    }
    else if (Channel == SynthSession.DrumChannel)
    {
        <p class="note">
            Channel @(SynthSession.DrumChannel + 1) is the drum part. Its program changes select a kit
            rather than an instrument, and they resolve through the drum map below, not through this
            table. Choose another channel to play an instrument.
        </p>
    }
    else
    {
        <div class="row">
            <label>
                Search
                <input type="search" value="@_search" @oninput="Searched" placeholder="piano, strings, 88…" />
            </label>

            @if (_search.Length == 0)
            {
                <span class="tag tag-muted">@catalogue.Banks.Count banks</span>
                <span class="tag tag-muted">@catalogue.NativeCount.ToString("N0") programs</span>
                <span class="tag tag-muted">@catalogue.ToneCount.ToString("N0") distinct tones</span>
            }
        </div>

        @if (_search.Length > 0)
        {
            @* Searching is the one time the hierarchy is in the way: a name can be anywhere, so the
               columns collapse to a flat list of everything that matches. *@
            var hits = Search(catalogue).ToList();

            <p class="note">@hits.Count match@(hits.Count == 1 ? "" : "es")@(hits.Count == SearchLimit ? ", showing the first " + SearchLimit : "").</p>

            <div class="hits">
                @foreach (var hit in hits)
                {
                    <button class="hit @(Selected(hit.Bank, hit.Entry.Program) ? "on" : "")"
                            @onclick="() => SelectAsync(hit.Bank, hit.Entry.Program)">
                        <span class="technical">@hit.Bank ⋅ @(hit.Entry.Program + 1)</span>
                        <span class="name">@hit.Entry.Name</span>
                    </button>
                }
            </div>
        }
        else
        {
            var variants = Variants(catalogue, Program);

            <div class="miller">
                <div class="column">
                    <div class="column-head">Vintage</div>
                    @foreach (var map in Enum.GetValues<ToneMap>())
                    {
                        var vintage = map;
                        <button class="item @(vintage == Session.Map ? "on" : "")"
                                @onclick="() => Session.Map = vintage">
                            <span class="name">@ToneCatalog.VintageName(vintage)</span>
                            <span class="technical">@(Catalog.For(vintage)?.Banks.Count ?? 0)</span>
                        </button>
                    }
                </div>

                <div class="column">
                    <div class="column-head">Instrument</div>
                    @foreach (var entry in catalogue.Banks[0].Programs)
                    {
                        @* The capital bank is the instrument list: it is the only bank every vintage
                           fills completely, so it is the one that names all 128 without holes. *@
                        var program = entry.Program;

                        if (program % ToneCatalog.FamilySize == 0)
                        {
                            <div class="group">@ToneCatalog.FamilyOf(program)</div>
                        }

                        <button class="item @(program == Program ? "on" : "")"
                                @onclick="() => OpenAsync(program)">
                            <span class="technical">@(program + 1)</span>
                            <span class="name">@entry.Name</span>
                        </button>
                    }
                </div>

                <div class="column">
                    <div class="column-head">Variant</div>
                    @foreach (var variant in variants)
                    {
                        var bank = variant.Bank;
                        <button class="item @(Selected(bank, Program) ? "on" : "")"
                                @onclick="() => SelectAsync(bank, Program)">
                            <span class="technical">@bank</span>
                            <span class="name">@variant.Entry.Name</span>
                        </button>
                    }
                </div>
            </div>

            <p class="note">
                @ToneCatalog.VintageName(Session.Map) defines
                @(variants.Count == 1 ? "only the capital tone" : $"{variants.Count} variations") of program
                @(Program + 1). Bank 0 is the capital; a bank not listed has no entry for this
                program and would sound the capital anyway.
            </p>
        }
    }
</section>

@code {
    /// <summary>The channel a chosen sound is sent to.</summary>
    [Parameter]
    public int Channel { get; set; }

    /// <summary>How many search hits are listed.</summary>
    /// <remarks>
    /// A vintage defines thousands of slots and a one-letter search matches most of them; a cap keeps
    /// a keystroke from laying out a page of results nobody reads. The count above says when it bites.
    /// </remarks>
    public const int SearchLimit = 120;

    private int? _browsing;
    private string _search = string.Empty;

    private readonly record struct Hit(int Bank, CatalogEntry Entry);

    private readonly record struct Variant(int Bank, CatalogEntry Entry);

    // Which instrument the third column is showing. Not a field on its own: with nothing browsed yet
    // it follows the part, so opening the panel shows the variants of whatever is actually sounding
    // rather than of program 1.
    private int Program =>
        _browsing ?? (Session.Parts is { } parts ? parts[Channel].Program : 0);

    // The picker follows the engine rather than remembering its own idea of what is selected: a
    // program change from hardware, from a song or from another panel moves the highlight too.
    protected override void OnInitialized() => Session.Changed += Redraw;

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= Redraw;

    private bool Selected(int bank, int program) =>
        Session.Parts is { } parts && parts[Channel].Bank == bank && parts[Channel].Program == program;

    private void Searched(ChangeEventArgs e) => _search = e.Value?.ToString()?.Trim() ?? string.Empty;

    // Every bank that defines this program itself. A bank whose slot is a capital fallback is left
    // out on purpose: it would sound identical to bank 0, so listing it would pad the column with
    // rows that are all the same sound.
    private static List<Variant> Variants(VintageCatalog catalogue, int program) =>
        [.. from bank in catalogue.Banks
            let entry = bank.Programs[program]
            where entry.Kind == CatalogEntryKind.Native
            select new Variant(bank.Bank, entry)];

    // Number as well as name, because "88" is how a bank is looked for and a program is as often
    // known by its number as by what it is called.
    private IEnumerable<Hit> Search(VintageCatalog catalogue) =>
        (from bank in catalogue.Banks
         from entry in bank.Programs
         where entry.Kind == CatalogEntryKind.Native &&
             (entry.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                 (entry.Program + 1).ToString() == _search ||
                 bank.Bank.ToString() == _search)
         select new Hit(bank.Bank, entry)).Take(SearchLimit);

    // Opening an instrument sounds its capital tone as well as listing its variants. A column that
    // only narrowed the next one would leave the middle click silent, and the point of the panel is
    // to hear things.
    private Task OpenAsync(int program)
    {
        _browsing = program;
        return SelectAsync(bank: 0, program);
    }

    private async Task SelectAsync(int bank, int program)
    {
        // Bank first, then program: a program change is what latches the pair, so the other order
        // would sound the old bank's tone until the next note picked up the new one.
        Session.SendControl(Channel, 0, bank);
        Session.SendChannel(0xC0 | Channel, program, 0);

        _browsing = program;
        await Pump.ArmForKeysAsync();
    }
}
