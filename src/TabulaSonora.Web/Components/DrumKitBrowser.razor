@implements IDisposable
@inject SynthSession Session
@inject ToneCatalog Catalog
@inject PlaybackPump Pump


@*
    The drum maps: every kit the program map reaches, and for each of them which key plays what.

    Keys are named from the melodic tone table, because drum sounds are melodic tones. Kit names are
    not in the ROM at all and are carried in DrumKitNames instead.
*@

<section class="panel enter-rise">
    <h2>Drum kits</h2>

    @if (Catalog.DrumsFor(Session.DrumMapRow) is not { } catalogue)
    {
        <p class="note">No ROM loaded.</p>
    }
    else
    {
        <div class="row">
            <label>
                Kit set
                <select value="@Session.DrumMapRow" @onchange="RowChanged">
                    @for (var row = 0; row < DrumKitNames.RowMaps.Length; row++)
                    {
                        var index = row;
                        <option value="@index">@DrumKitNames.RowName(index)</option>
                    }
                </select>
            </label>

            <span class="tag tag-muted">@catalogue.Kits.Count kits</span>

            <span class="note">
                A kit does not resolve through the vintage's tone map: a program change on the drum
                part goes through its own pair of lookups, and both rows are there whichever module is
                selected. What the rows <em>are</em> is settled by their contents &mdash; the programs
                row 0 defines are exactly the SC-8820's kit list and row 1's are the SC-88Pro's, with
                the CM-64/32L kit at program 128 that both rows carry and neither list mentions. The
                module picks between them from the part's internal bank code, which is not decoded
                here, so it is chosen directly.
            </span>
        </div>

        <div class="kits">
            @foreach (var kit in catalogue.Kits)
            {
                var index = kit.Kit;
                var programs = string.Join(", ", kit.Programs.Take(3).Select(p => p + 1));
                <button class="kit @(index == Session.DrumKit ? "on" : "")" @onclick="() => SelectAsync(kit)">
                    <span class="name">@(DrumKitNames.ForRow(Session.DrumMapRow, kit.Programs[0]) ?? $"PC {programs}")</span>
                    <span class="count">@kit.Keys.Count keys</span>
                </button>
            }
        </div>

        <p class="note">
            Kit names are not in the engine &mdash; it names every drum <em>sound</em>, but nothing in
            it says program 9 is "ROOM" &mdash; so they are carried here instead. Program 128 is the
            exception: the CM-64/32L kit is defined by the ROM on both sets and named by neither
            module's list, so it keeps its number.
        </p>

        @if (catalogue.Kits.FirstOrDefault(k => k.Kit == Session.DrumKit) is { } showing)
        {
            <div class="pads">
                @foreach (var key in showing.Keys)
                {
                    var note = key.Note;
                    <button class="pad" title="@Explain(key)" @onpointerdown="e => StrikeAsync(note, e)">
                        <span class="technical">@ToneCatalog.NoteName(note)</span>
                        <span class="name">@key.Name</span>
                    </button>
                }
            </div>

            <p class="note">
                Kit #@showing.Kit, @showing.Keys.Count keys. A pad strikes channel
                @(SynthSession.DrumChannel + 1) as hard as where you hit it &mdash; soft at the left
                edge, up to the panel's ceiling at the right. Drums ring out, so a pad has nothing to
                release. Hover one for its level, coarse pitch, mute group and pan.
            </p>
        }
    }
</section>

@code {
    /// <summary>The velocity a strike at the far right of a pad sends.</summary>
    [Parameter]
    public int Velocity { get; set; } = 127;

    // Which kit is showing is not this panel's state: it is the engine's, read from it rather than
    // recomputed, because selecting one sends the program change that selects it and a song or a
    // controller moves it the same way.
    protected override void OnInitialized() => Session.Changed += Redraw;

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= Redraw;

    private void RowChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var row))
        {
            return;
        }

        Session.DrumMapRow = row;

        // The row only decides how the *next* program change resolves, so without re-sending the one
        // in force the part would go on sounding the other map's kit while this panel showed the new
        // map's list -- true of the engine, and a lie about what a key will do.
        if (Session.Parts is { } parts)
        {
            Session.SendChannel(
                0xC0 | SynthSession.DrumChannel, parts[SynthSession.DrumChannel].Program, 0);
        }
    }

    // Selecting a kit is a program change, not a setting: the engine has no other way in, and an
    // undefined program leaves the kit alone rather than silencing the part.
    private async Task SelectAsync(DrumKitEntry kit)
    {
        Session.SendChannel(0xC0 | SynthSession.DrumChannel, kit.Programs[0], 0);
        await Pump.ArmForKeysAsync();
    }

    /// <summary>
    /// Pad width in CSS pixels, mirroring <c>--pad-width</c> in <c>app.css</c>.
    /// </summary>
    /// <remarks>
    /// A pointer event says where in the pad it landed but not how wide the pad is, and asking the
    /// browser per strike would put an interop round trip in front of every hit. So the two agree by
    /// hand, and the pad grid uses a fixed track rather than a stretching one to keep them agreeing.
    /// </remarks>
    private const double PadWidth = 112;

    // Left to right is soft to hard, which is the reading a horizontal strip invites and the one the
    // keyboard's top-to-bottom already establishes for this panel. Pointer-down rather than click,
    // so a pad answers on the way down like a drum does -- and pads have nothing to release, because
    // drums ring out.
    private async Task StrikeAsync(int note, PointerEventArgs e)
    {
        await Pump.ArmForKeysAsync();

        var force = Math.Clamp((int)Math.Round(e.OffsetX / PadWidth * Velocity), 1, 127);
        Session.SendChannel(0x90 | SynthSession.DrumChannel, note, force);
    }

    private static string Explain(DrumKeyEntry key) =>
        $"tone #{key.Tone} · level {key.Level} · pitch {key.Pitch} · " +
        $"group {(key.Group == 0 ? "none" : key.Group.ToString())} · pan {key.Pan}";
}
