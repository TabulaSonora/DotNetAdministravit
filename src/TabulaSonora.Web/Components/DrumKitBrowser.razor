@implements IDisposable
@inject SynthSession Session
@inject ToneCatalog Catalog
@inject PlaybackPump Pump
@inject AssetStore Store

@*
    The drum maps: every kit the program map reaches, and for each of them which key plays what.

    Kits are labelled by the programs that select them, and keys by the tone they sound, because that
    is all the ROM holds. The DLL carries no kit-name or drum-key-name table at all -- those live in
    the plugin's companion tone files -- so a list saying "Room" or "Power" here would be a name this
    application invented, not one it read.
*@

<section class="panel enter-rise">
    <h2>Drum kits</h2>

    @if (Catalog.DrumsFor(Session.DrumMapRow) is not { } catalogue)
    {
        <p class="note">No ROM loaded.</p>
    }
    else
    {
        <div class="row">
            <label>
                Kit set
                <select value="@Session.DrumMapRow" @onchange="RowChanged">
                    @for (var row = 0; row < SoundCatalog.DrumMapRows; row++)
                    {
                        var index = row;
                        <option value="@index">@RowName(index)</option>
                    }
                </select>
            </label>

            <span class="tag tag-muted">@catalogue.Kits.Count kits</span>

            <span class="note">
                A kit does not resolve through the vintage's tone map: a program change on the drum
                part goes through its own pair of lookups, and both rows are there whichever module is
                selected. What the rows <em>are</em> is settled by their contents &mdash; the programs
                row 0 defines are exactly the SC-8820's kit list and row 1's are the SC-88Pro's, with
                the CM-64/32L kit at program 128 that both rows carry and neither list mentions. The
                module picks between them from the part's internal bank code, which is not decoded
                here, so it is chosen directly.
            </span>
        </div>

        <div class="kits">
            @foreach (var kit in catalogue.Kits)
            {
                var index = kit.Kit;
                var programs = string.Join(", ", kit.Programs.Take(3).Select(p => p + 1));
                <button class="kit @(index == Session.DrumKit ? "on" : "")" @onclick="() => SelectAsync(kit)">
                    <span class="name">@(KitName(kit) ?? $"PC {programs}")</span>
                    <span class="count">@kit.Keys.Count keys</span>
                </button>
            }
        </div>

        @* Optional, and it stays here the way the DLL does. The engine's own tables name every drum
           sound but nothing in them says program 9 is "ROOM" -- those names are in the plugin's file,
           which is Roland's to distribute and not this page's to carry. *@
        <div class="row">
            @if (_names is { IsEmpty: false } loaded)
            {
                var named = loaded.CountFor(
                    RowMaps[Session.DrumMapRow], catalogue.Kits.Select(k => k.Programs[0]));

                @* Named, and named FOR THIS SET. A file can parse, report a healthy count and still
                   answer nothing here -- GM.drf is one page naming one kit -- and a bare success tag
                   over a column of program numbers is indistinguishable from the feature being
                   broken. So the count that matters is the one on screen. *@
                <span class="tag @(named == 0 ? "tag-warn" : "tag-success")">
                    @named of @catalogue.Kits.Count named from @loaded.Module
                </span>
                <button class="btn btn-secondary btn-tiny" @onclick="ForgetNamesAsync">Forget</button>

                @if (named == 0)
                {
                    <span class="note">
                        That file has no page for this kit set &mdash; it names @loaded.Count kit(s)
                        across @loaded.Maps.Count page(s). <code>GM.drf</code> is the small one;
                        <code>SCVSC.drf</code>, in the same folder, is the one that names all of them.
                    </span>
                }
            }
            else
            {
                <label>
                    Kit names
                    <input type="file" accept=".drf" @ref="_picker" @onchange="NamesPickedAsync" />
                </label>
                <span class="note">
                    Optional: <code>SCVSC.drf</code> &mdash; not <code>GM.drf</code>, which sits beside
                    it and names almost nothing &mdash; from the folder holding your
                    <code>SCCore.dll</code>. Kits are known by their program number until you supply
                    it, because the names are in that file rather than in the engine. It is read and
                    kept in this browser, like the DLL.
                </span>
            }

            @if (_error is not null)
            {
                <span class="error">@_error</span>
            }
        </div>

        @if (catalogue.Kits.FirstOrDefault(k => k.Kit == Session.DrumKit) is { } showing)
        {
            <div class="pads">
                @foreach (var key in showing.Keys)
                {
                    var note = key.Note;
                    <button class="pad" title="@Explain(key)" @onpointerdown="e => StrikeAsync(note, e)">
                        <span class="technical">@ToneCatalog.NoteName(note)</span>
                        <span class="name">@key.Name</span>
                    </button>
                }
            </div>

            <p class="note">
                Kit #@showing.Kit, @showing.Keys.Count keys. A pad strikes channel
                @(SynthSession.DrumChannel + 1) as hard as where you hit it &mdash; soft at the left
                edge, up to the panel's ceiling at the right. Drums ring out, so a pad has nothing to
                release. Hover one for its level, coarse pitch, mute group and pan.
            </p>
        }
    }
</section>

@code {
    /// <summary>The velocity a pad strikes at.</summary>
    [Parameter]
    public int Velocity { get; set; } = 100;

    private DrumKitNames? _names;
    private ElementReference _picker;
    private string? _error;

    /// <summary>
    /// Which tone map's kit list each drum map row holds.
    /// </summary>
    /// <remarks>
    /// Measured, not assumed: the set of programs row 0 defines is exactly the one the plugin's own
    /// <c>SCVSC.drf</c> lists on its SC-8820 page, and row 1's is exactly its SC-88Pro page — in both
    /// cases plus program 127, the CM-64/32L kit, which the ROM defines and neither page offers. The
    /// index is also what names the kits, since the file is paged by tone map.
    /// </remarks>
    private static readonly int[] RowMaps = [4, 3];

    // Which kit is showing is not this panel's state: it is the engine's, read from it rather than
    // recomputed, because selecting one sends the program change that selects it and a song or a
    // controller moves it the same way.
    protected override void OnInitialized() => Session.Changed += Redraw;

    protected override async Task OnInitializedAsync()
    {
        // Supplied on an earlier visit; nothing to ask about.
        if (await Store.DescribeAsync(AssetStore.DrumNamesKey) is not null)
        {
            await LoadNamesAsync();
        }
    }

    private static string RowName(int row) =>
        row < RowMaps.Length ? ToneCatalog.VintageName((ToneMap)RowMaps[row]) : $"row {row}";

    private string? KitName(DrumKitEntry kit)
    {
        if (_names is null || Session.DrumMapRow >= RowMaps.Length)
        {
            return null;
        }

        // A kit can be reached by several programs; the first is the one the file names it under.
        return _names.Lookup(RowMaps[Session.DrumMapRow], kit.Programs[0]);
    }

    private async Task NamesPickedAsync()
    {
        _error = null;

        try
        {
            if (await Store.PutFromInputAsync(AssetStore.DrumNamesKey, _picker) is not null)
            {
                await LoadNamesAsync();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task LoadNamesAsync()
    {
        try
        {
            if (await Store.ReadAsync(AssetStore.DrumNamesKey) is { } bytes)
            {
                _names = DrumKitNames.Parse(bytes);
            }
        }
        catch (InvalidDataException ex)
        {
            // A wrong file must not stay cached to fail again on the next visit.
            _error = ex.Message;
            await Store.RemoveAsync(AssetStore.DrumNamesKey);
            _names = null;
        }
    }

    private async Task ForgetNamesAsync()
    {
        await Store.RemoveAsync(AssetStore.DrumNamesKey);
        _names = null;
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= Redraw;

    private void RowChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var row))
        {
            return;
        }

        Session.DrumMapRow = row;

        // The row only decides how the *next* program change resolves, so without re-sending the one
        // in force the part would go on sounding the other map's kit while this panel showed the new
        // map's list -- true of the engine, and a lie about what a key will do.
        if (Session.Parts is { } parts)
        {
            Session.SendChannel(
                0xC0 | SynthSession.DrumChannel, parts[SynthSession.DrumChannel].Program, 0);
        }
    }

    // Selecting a kit is a program change, not a setting: the engine has no other way in, and an
    // undefined program leaves the kit alone rather than silencing the part.
    private async Task SelectAsync(DrumKitEntry kit)
    {
        Session.SendChannel(0xC0 | SynthSession.DrumChannel, kit.Programs[0], 0);
        await Pump.ArmForKeysAsync();
    }

    /// <summary>
    /// Pad width in CSS pixels, mirroring <c>--pad-width</c> in <c>app.css</c>.
    /// </summary>
    /// <remarks>
    /// A pointer event says where in the pad it landed but not how wide the pad is, and asking the
    /// browser per strike would put an interop round trip in front of every hit. So the two agree by
    /// hand, and the pad grid uses a fixed track rather than a stretching one to keep them agreeing.
    /// </remarks>
    private const double PadWidth = 112;

    // Left to right is soft to hard, which is the reading a horizontal strip invites and the one the
    // keyboard's top-to-bottom already establishes for this panel. Pointer-down rather than click,
    // so a pad answers on the way down like a drum does -- and pads have nothing to release, because
    // drums ring out.
    private async Task StrikeAsync(int note, PointerEventArgs e)
    {
        await Pump.ArmForKeysAsync();

        var force = Math.Clamp((int)Math.Round(e.OffsetX / PadWidth * Velocity), 1, 127);
        Session.SendChannel(0x90 | SynthSession.DrumChannel, note, force);
    }

    private static string Explain(DrumKeyEntry key) =>
        $"tone #{key.Tone} · level {key.Level} · pitch {key.Pitch} · " +
        $"group {(key.Group == 0 ? "none" : key.Group.ToString())} · pan {key.Pan}";
}
