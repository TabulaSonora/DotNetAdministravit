<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TabulaSonora\TabulaSonora.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tabula-sonora</AssemblyName>
    <!--
      The effect harvester drives SCCore.dll through unmanaged function pointers. This is the only
      place in the project that loads the DLL as code, and it is confined to the setup tool.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
